#!/bin/bash
# Manage the robots (Control Hubs) this Pi knows. The Mac app and the `ftc-bridge` command
# run this over SSH, as root via sudo:
#   ftc-hub status        ->  robot=<name>, ssid=<wifi>, hub=up|down (ping), adbd=up|down (a real ADB
#                             handshake: the robot is ready for uploads), one saved=<name><TAB><wifi> per robot
#   ftc-hub scan          ->  nearby Wi-Fi names, one per line
#   ftc-hub list          ->  saved robots, one <name><TAB><wifi> per line
#   ftc-hub add NAME      ->  saves a robot; reads its Wi-Fi name, then password, from stdin (one per line)
#   ftc-hub use NAME      ->  switches the Pi to that robot's Wi-Fi
#   ftc-hub forget NAME   ->  deletes a saved robot
#   ftc-hub health        ->  Wi-Fi signal/channel, whether the robot app and adb answer, and the hub's
#                             serial compared with the one saved for this robot (is it the right robot?)
#   ftc-hub disconnect    ->  leaves the robot's Wi-Fi and stays off it (before a match: rule R704.C)
#   ftc-hub power reboot|off  ->  restarts or shuts down the Pi (shut down before unplugging)
#   ftc-hub links         ->  how often the USB link to the computer went dead and was re-plugged
#                             (ftc-linkwatch), in every saved run, and the last few times
set -euo pipefail
HUB_IP=192.168.43.1
PREFIX=robot-  # each robot is a NetworkManager connection called robot-<name>
STATE=/var/lib/ftc-hub  # <name>.serial: the hub serial first seen for each robot

wifi_on() {  # Raspberry Pi OS starts with Wi-Fi switched off in NetworkManager
  rfkill unblock wifi 2>/dev/null || true
  nmcli radio wifi on
}
# A real ADB handshake: send ADB's CNXN hello and wait for adbd's reply (CNXN, or AUTH when it
# wants a key). A ping or an open port doesn't prove adbd answers: right after the robot boots it
# accepts connections for a while without replying. Prints "CNXN 12" / "AUTH 12" (reply, ms) or "none".
adb_hello() {
  python3 - "$1" "${2:-5555}" "${3:-2}" <<'PY'
import socket, struct, sys, time
host, port, timeout = sys.argv[1], int(sys.argv[2]), float(sys.argv[3])
payload = b"host::\0"
cnxn = 0x4E584E43  # "CNXN"
hello = struct.pack("<6I", cnxn, 0x01000001, 4096, len(payload), sum(payload), cnxn ^ 0xFFFFFFFF) + payload
start = time.monotonic()
try:
    with socket.create_connection((host, port), timeout=timeout) as s:
        s.settimeout(timeout)
        s.sendall(hello)
        head = b""
        while len(head) < 24:
            chunk = s.recv(24 - len(head))
            if not chunk:
                break
            head += chunk
    reply = head[:4].decode("ascii", "replace") if len(head) == 24 else ""
    print(f"{reply} {round((time.monotonic() - start) * 1000)}" if reply in ("CNXN", "AUTH") else "none")
except OSError:
    print("none")
PY
}
check_name() {
  [[ "$1" =~ ^[A-Za-z0-9._-]{1,32}$ ]] ||
    { echo "Robot names can use letters, numbers, . _ - (up to 32)"; exit 1; }
}
saved() { nmcli -t -g NAME con show | sed -n "s/^$PREFIX//p"; }
ssid_of() { nmcli -g 802-11-wireless.ssid con show "$PREFIX$1"; }
require_saved() {
  saved | grep -qxF "$1" || { echo "No saved robot called '$1'. Saved: $(saved | tr '\n' ' ')"; exit 1; }
}

case "${1:-}" in
  status)
    ROBOT="$(nmcli -t -g NAME con show --active | sed -n "s/^$PREFIX//p" | head -1)"
    echo "robot=$ROBOT"
    echo "ssid=$([[ -n "$ROBOT" ]] && ssid_of "$ROBOT" || true)"
    if ping -c1 -W1 "$HUB_IP" >/dev/null 2>&1; then
      echo "hub=up"
      read -r reply ms <<<"$(adb_hello "$HUB_IP" 5555 1.5)"
      if [[ "$reply" == CNXN || "$reply" == AUTH ]]; then echo "adbd=up"; echo "adbd_ms=$ms"; else echo "adbd=down"; fi
    else
      echo "hub=down"; echo "adbd=down"
    fi
    for r in $(saved); do printf 'saved=%s\t%s\n' "$r" "$(ssid_of "$r")"; done
    ;;
  scan)
    wifi_on
    for _ in 1 2 3; do  # right after the radio turns on, the first scan can come back empty
      LIST="$(nmcli -g SSID dev wifi list --rescan auto 2>/dev/null | sed 's/\\:/:/g' | grep -v '^$' | sort -u || true)"
      [[ -n "$LIST" ]] && break
      sleep 3
    done
    [[ -z "$LIST" ]] || printf '%s\n' "$LIST"
    ;;
  list)
    for r in $(saved); do printf '%s\t%s\n' "$r" "$(ssid_of "$r")"; done
    ;;
  add)
    NAME="${2:-}"; check_name "$NAME"
    IFS= read -r SSID; IFS= read -r PSK
    SSID="${SSID%$'\r'}"; PSK="${PSK%$'\r'}"  # Windows sends line endings with a \r
    [[ ${#SSID} -ge 1 && ${#SSID} -le 32 ]] || { echo "Wi-Fi name must be 1-32 characters"; exit 1; }
    [[ ${#PSK} -ge 8 && ${#PSK} -le 63 ]] || { echo "Password must be 8-63 characters"; exit 1; }
    nmcli con delete "$PREFIX$NAME" >/dev/null 2>&1 || true
    rm -f "$STATE/$NAME.serial"  # re-saving a robot may mean a different hub
    # The password is briefly in nmcli's argv; fine on this single-user Pi.
    nmcli con add type wifi con-name "$PREFIX$NAME" ifname wlan0 ssid "$SSID" \
      wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$PSK" connection.autoconnect no >/dev/null
    echo "Saved $NAME ($SSID)"
    ;;
  use)
    NAME="${2:-}"; check_name "$NAME"; require_saved "$NAME"
    wifi_on
    # Only the chosen robot reconnects by itself (e.g. after the Pi restarts).
    for r in $(saved); do nmcli con modify "$PREFIX$r" connection.autoconnect no; done
    nmcli con modify "$PREFIX$NAME" connection.autoconnect yes
    nmcli --wait 20 con up "$PREFIX$NAME" >/dev/null 2>&1 ||
      { echo "Couldn't join $NAME ($(ssid_of "$NAME")). Is the robot on? A wrong password also causes this."; exit 1; }
    echo "Connected to $NAME"
    ;;
  forget)
    NAME="${2:-}"; check_name "$NAME"; require_saved "$NAME"
    nmcli con delete "$PREFIX$NAME" >/dev/null
    rm -f "$STATE/$NAME.serial"
    echo "Forgot $NAME"
    ;;
  health)
    ROBOT="$(nmcli -t -g NAME con show --active | sed -n "s/^$PREFIX//p" | head -1)"
    echo "robot=$ROBOT"
    echo "pi_uptime_s=$(cut -d' ' -f1 /proc/uptime | cut -d. -f1)"
    echo "forwarder=$(systemctl is-active adb-forward 2>/dev/null || true)"
    echo "linkwatch=$(systemctl is-active ftc-linkwatch 2>/dev/null || true)"
    # The Wi-Fi the Pi is really on, to compare with the robot it's set to.
    [[ -n "$ROBOT" ]] && echo "wifi_expected=$(ssid_of "$ROBOT")"
    echo "wifi_actual=$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | sed -n 's/^yes://p' | sed 's/\\:/:/g' | head -1)"
    # The connected network's signal (0-100), frequency, channel and link rate.
    nmcli -t -f IN-USE,SIGNAL,FREQ,CHAN,RATE dev wifi list --rescan no 2>/dev/null |
      awk -F: '$1=="*" {print "signal="$2; print "freq="$3; print "channel="$4; print "rate="$5; exit}'
    PING_MS="$(ping -c1 -W1 "$HUB_IP" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\).*/\1/p')"
    echo "hub_ping_ms=${PING_MS:-none}"
    if nc -z -w 2 "$HUB_IP" 5555 2>/dev/null; then echo "adb_port=open"; else echo "adb_port=closed"; fi
    read -r reply ms <<<"$(adb_hello "$HUB_IP" 5555 3)"
    echo "adbd_reply=${reply:-none}"; [[ "$reply" == CNXN || "$reply" == AUTH ]] && echo "adbd_ms=$ms"
    # The Robot Controller app's own status page. (It also holds the Wi-Fi password: never print it.)
    INFO="$(python3 - "$HUB_IP" <<'PY'
import json, sys, urllib.request
try:
    d = json.load(urllib.request.urlopen(f"http://{sys.argv[1]}:8080/js/rcInfo.json", timeout=2))
except Exception:
    print("rc_app=down"); sys.exit()
print("rc_app=up")
for key in ("serialNumber", "networkName", "activeConfigName", "sdkVersion", "supports5GhzAp"):
    if d.get(key) is not None: print(f"{key}={d[key]}")
ch = d.get("currentChannel")
if isinstance(ch, dict): ch = ch.get("displayName") or ch.get("name") or ch.get("channelNum")
if ch is not None: print(f"hubChannel={ch}")
PY
)"
    echo "$INFO"
    SERIAL="$(sed -n 's/^serialNumber=//p' <<<"$INFO")"
    if [[ -n "$ROBOT" && -n "$SERIAL" ]]; then
      mkdir -p "$STATE"
      if [[ ! -f "$STATE/$ROBOT.serial" ]]; then
        echo "$SERIAL" > "$STATE/$ROBOT.serial"; echo "same_hub=first_time"
      elif [[ "$(cat "$STATE/$ROBOT.serial")" == "$SERIAL" ]]; then
        echo "same_hub=yes"
      else
        echo "same_hub=no"; echo "saved_serial=$(cat "$STATE/$ROBOT.serial")"
      fi
    fi
    ;;
  disconnect)
    for r in $(saved); do nmcli con modify "$PREFIX$r" connection.autoconnect no; done
    for r in $(nmcli -t -g NAME con show --active | sed -n "s/^$PREFIX//p"); do nmcli con down "$PREFIX$r" >/dev/null; done
    echo "Off the robot's Wi-Fi"
    ;;
  power)
    # Delayed by 2 s so this SSH call can return before the Pi goes down.
    case "${2:-}" in
      reboot) systemd-run --quiet --on-active=2 /usr/bin/systemctl reboot; echo "Restarting the Pi" ;;
      off) systemd-run --quiet --on-active=2 /usr/bin/systemctl poweroff; echo "Shutting down the Pi. Unplug it when the green light stays off." ;;
      *) echo "usage: ftc-hub power reboot|off" >&2; exit 2 ;;
    esac
    ;;
  links)
    systemctl is-active --quiet ftc-linkwatch && echo "USB link watcher: on" ||
      echo "USB link watcher: OFF (ftc-bridge update-pi installs it)"
    runs=0; dead=0; back=0; lost=0; restarts=0
    while read -r idx _; do
      runs=$((runs + 1))
      ev="$(journalctl -b "$idx" -t ftc-linkwatch -q --no-pager 2>/dev/null || true)"
      dead=$((dead + $(grep -c 'LINK DEAD' <<<"$ev" || true)))
      back=$((back + $(grep -c 'BACK:' <<<"$ev" || true)))
      lost=$((lost + $(grep -c 'NOT BACK' <<<"$ev" || true)))
      restarts=$((restarts + $(grep -c 'RESTARTING THE PI' <<<"$ev" || true)))
    done < <(journalctl --list-boots --no-pager -q 2>/dev/null)
    echo "Dead links: $dead in the $runs saved runs ($back came back after a re-plug, $restarts needed the Pi restarted," \
      "$lost needed the cable pulled)"
    # the last few, with how long the Pi had been running (minutes) when it happened
    journalctl -t ftc-linkwatch -q --no-pager -o short-monotonic 2>/dev/null | grep -E 'LINK DEAD|BACK|RESTARTING' | tail -n 6 |
      awk '{ up = 0; if (match($0, /^\[ *[0-9.]+\]/)) up = substr($0, RSTART + 1, RLENGTH - 2) + 0
             sub(/^.*ftc-linkwatch\[[0-9]+\]: /, "")
             printf "  %3d min after the Pi started: %s\n", up / 60, substr($0, 1, 150) }'
    ;;
  *)
    echo "usage: ftc-hub status|scan|list|add NAME|use NAME|forget NAME|health|disconnect|power reboot|off|links" >&2; exit 2
    ;;
esac
